{
  "manifest_version": 3,
  "name": "Klangdeck for Google Meet",
  "version": "1.3.0",
  "description": "Mixes Klangdeck sounds locally into your Google Meet microphone.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "mixer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Klangdeck for Google Meet",
    "default_popup": "popup.html"
  }
}
